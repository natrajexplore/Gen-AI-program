# Copy to .env and fill in. Never commit .env.

# Required for the AI tutor and the content studio
OPENAI_API_KEY=
# Optional: model for the tutor and the agent crew (default gpt-4o-mini)
NETVERSE_MODEL=gpt-4o-mini

# Content studio login. Leave empty to disable the studio.
ADMIN_PASSWORD=
# Signs admin session cookies. Use a long random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Tutor rate limit per client IP: questions per window (seconds)
TUTOR_RATE_LIMIT=20
TUTOR_RATE_WINDOW=600

# Behind a reverse proxy: the proxy's IP, so rate limits see real client addresses
# FORWARDED_ALLOW_IPS=127.0.0.1
